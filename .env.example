# Скопіюй у .env.
DATABASE_URL=postgresql://ge:ge@localhost:5432/ge
TEST_DATABASE_URL=postgresql://ge:ge@localhost:5432/ge_test
API_PORT=3000
NODE_ENV=development

# Better Auth: секрет не менше 32 символів (згенеруй: openssl rand -base64 32)
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
WEB_ORIGIN=http://localhost:5173
# Фонові задачі: pgboss (за замовчуванням) або inline (виконання в процесі, без черги)
# JOBS_DRIVER=pgboss
# PDF-відомості: Gotenberg (docker compose up gotenberg). Без нього доступний лише DOCX.
# GOTENBERG_URL=http://localhost:3200
# Вхід через Google (необов'язково). Redirect URI: ${WEB_ORIGIN}/api/v1/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Пароль демо-користувачів (teacher@demo.local, dekanat@demo.local, both@demo.local) для seed
DEMO_PASSWORD=demo-password-123
